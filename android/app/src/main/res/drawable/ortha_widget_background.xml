<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
        ORTHA Glass Widget Ω

        Alpha 0D entspricht ungefähr 5 % Deckkraft
        beziehungsweise 95 % Transparenz.

        Der Hintergrund bleibt damit nahezu durchsichtig,
        während die Inhalte des Widgets vollständig sichtbar bleiben.
    -->
    <gradient
        android:angle="315"
        android:startColor="#0D8ED8F8"
        android:centerColor="#0D17374A"
        android:endColor="#0D061923"
        android:type="linear" />

    <corners android:radius="24dp" />

    <!-- Dezenter heller Glasrand -->
    <stroke
        android:width="1dp"
        android:color="#668ED8F8" />

    <padding
        android:left="16dp"
        android:top="14dp"
        android:right="16dp"
        android:bottom="14dp" />

</shape>
