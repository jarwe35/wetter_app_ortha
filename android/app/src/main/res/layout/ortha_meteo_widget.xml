<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ortha_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ortha_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/ortha_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ORTHA METEO Ω"
        android:textColor="#9ED7F5"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ortha_widget_place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="Duisburg"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ortha_widget_temperature"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-- °C"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ortha_widget_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Wettersymbol"
            android:text="☀"
            android:textColor="#FFE56B"
            android:textSize="28sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ortha_widget_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#244F4559"
        android:gravity="center"
        android:padding="7dp"
        android:text="● Warnlage: Grün"
        android:textColor="#77D6A6"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ortha_widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="App öffnen für aktuelle Daten"
        android:textColor="#B9CAD4"
        android:textSize="10sp" />

</LinearLayout>
