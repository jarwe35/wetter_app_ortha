<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ortha_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ortha_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <!-- Hauptbereich -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Logo und Warnampel -->
        <LinearLayout
            android:layout_width="74dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingRight="5dp">

            <ImageView
                android:id="@+id/ortha_widget_refresh"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:adjustViewBounds="true"
                android:contentDescription="Wetterdaten aktualisieren"
                android:scaleType="fitCenter"
                android:src="@drawable/ortha_meteo_master" />

            <TextView
                android:id="@+id/ortha_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="ORTHA METEO Ω"
                android:textColor="#F3F7FA"
                android:textSize="7sp"
                android:textStyle="bold" />

            <!-- Sichtbare Warnampel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="5dp"
                android:background="#33152A38"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">

                <TextView
                    android:id="@+id/ortha_widget_light_green"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="●"
                    android:textColor="#43D36B"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/ortha_widget_light_yellow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="●"
                    android:textColor="#F1C232"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/ortha_widget_light_red"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="●"
                    android:textColor="#E53935"
                    android:textSize="18sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/ortha_widget_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Keine amtliche Warnung"
                android:textColor="#59DD82"
                android:textSize="7sp" />

        </LinearLayout>

        <!-- Trennlinie -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="92dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="9dp"
            android:background="#527D99AC"
            android:text="" />

        <!-- Aktuelles Wetter -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.50"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/ortha_widget_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Duisburg"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="Aktuelles Wetter"
                android:textColor="#839CAC"
                android:textSize="10sp" />

            <!-- Temperatur vollständig in einer Zeile -->
            <TextView
                android:id="@+id/ortha_widget_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="20 °C"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ortha_widget_symbol"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="🌦️"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/ortha_widget_apparent_temperature"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Gefühlt 20 °C"
                    android:textColor="#39B9F1"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Trennlinie -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="92dp"
            android:layout_marginEnd="7dp"
            android:background="#527D99AC"
            android:text="" />

        <!-- Heute -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.72"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <TextView
                android:id="@+id/ortha_widget_day_1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="Heute"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ortha_widget_day_1_symbol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="🌦️"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/ortha_widget_day_1_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="24° / 15°"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- Trennlinie -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="86dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:background="#527D99AC"
            android:text="" />

        <!-- Tag 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.72"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <TextView
                android:id="@+id/ortha_widget_day_2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="Mo"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ortha_widget_day_2_symbol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="🌦️"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/ortha_widget_day_2_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="22° / 14°"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- Trennlinie -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="86dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:background="#527D99AC"
            android:text="" />

        <!-- Tag 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.72"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <TextView
                android:id="@+id/ortha_widget_day_3_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="Di"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ortha_widget_day_3_symbol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="☁️"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/ortha_widget_day_3_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="32° / 21°"
                android:textColor="#FFFFFF"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Untere Linie -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="82dp"
        android:layout_marginTop="3dp"
        android:background="#385D7788"
        android:text="" />

    <!-- Aktualisierungszeit -->
    <TextView
        android:id="@+id/ortha_widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="end"
        android:maxLines="1"
        android:text="Aktualisiert: --:-- Uhr"
        android:textColor="#8198A8"
        android:textSize="8sp" />

</LinearLayout>
